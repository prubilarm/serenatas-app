{
  "expo": {
    "name": "Mariachi Aventurero",
    "slug": "mariachi-aventurero",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aventurero.mobile"
    },
    "android": {
      "package": "com.aventurero.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "e00f3ea5-d8a0-41d0-aac8-37430f884ac3"
      }
    },
    "owner": "rubilarp57",
    "plugins": [
      "expo-dev-client",
      "expo-secure-store",
      "expo-asset",
      "@react-native-community/datetimepicker"
    ]
  }
}
